JINGAO_ENV=development
JINGAO_DEV_MODE=true
JINGAO_BOOTSTRAP_USERNAME=founder
JINGAO_BOOTSTRAP_PASSWORD=请替换为强密码
JINGAO_SESSION_HOURS=8
JINGAO_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATABASE_URL=sqlite:///./data/jingao.db

# 仅在后续获准启用 L1-L2 云端生成/Embedding 时配置。
# 测试密钥不得复用，不得写入本文件示例、源码、Git 或 Skill。
ORIGINGAME_BASE_URL=https://api.origingame.dev/v1
ORIGINGAME_API_KEY=
JINGAO_PRIMARY_MODEL=grok-4.5
JINGAO_FALLBACK_MODEL=deepseek-v4-flash
JINGAO_LLM_ENABLED=false
# L3 生成上下文默认不出网；只有创始人明确批准后才改为 true。
JINGAO_LLM_L3_ENABLED=false
JINGAO_LLM_TIMEOUT_SECONDS=45
JINGAO_LLM_MAX_CONTEXT_CHARACTERS=10000
JINGAO_EMBEDDING_MODEL=text-embedding-3-large
JINGAO_EMBEDDING_ENABLED=false
# L3 文本默认不出网；只有创始人明确批准后才改为 true。
JINGAO_EMBEDDING_L3_ENABLED=false
JINGAO_EMBEDDING_BATCH_SIZE=16
JINGAO_LOGIN_MAX_ATTEMPTS=5
JINGAO_LOGIN_WINDOW_SECONDS=900
JINGAO_LOGIN_LOCKOUT_SECONDS=900
JINGAO_BACKUP_DIR=./backups
JINGAO_BACKUP_MAX_AGE_SECONDS=93600
JINGAO_KNOWLEDGE_ROOT=./data
JINGAO_SOURCE_RECONCILE_INTERVAL_SECONDS=86400
JINGAO_SOURCE_HEALTH_MAX_AGE_SECONDS=93600
JINGAO_DISK_WARNING_PERCENT=80
JINGAO_DISK_CRITICAL_PERCENT=90
JINGAO_MEMORY_WARNING_PERCENT=80
JINGAO_MEMORY_CRITICAL_PERCENT=90
