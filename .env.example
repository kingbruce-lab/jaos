JINGAO_AGENT_URL=http://127.0.0.1:8000

# NAS Docker Compose：正式值只写入未提交的 .env。
JINGAO_DB_PASSWORD=
JINGAO_BOOTSTRAP_PASSWORD=
JINGAO_KNOWLEDGE_PATH=
# 多个地址用英文逗号分隔；NAS 上线时填写实际访问地址。
JINGAO_WEB_ORIGINS=http://localhost:3000
JINGAO_WEB_PORT=3000
# Web 入口只接受这些 Host；公网域名和员工使用的局域网域名/IP都必须列出。
JINGAO_WEB_HOSTS=localhost,127.0.0.1,web,jadj-nas.local,192.168.2.53,knowledge.jingao.club
JINGAO_WEB_MAX_REQUEST_BODY_BYTES=2147483648
JINGAO_INBOX_SCAN_INTERVAL_SECONDS=900
JINGAO_INBOX_SETTLE_SECONDS=120
JINGAO_INBOX_MAX_FILE_BYTES=2147483648
JINGAO_SOURCE_RECONCILE_INTERVAL_SECONDS=86400
JINGAO_SOURCE_HEALTH_MAX_AGE_SECONDS=93600
# 必须指向 NAS 之外或另一块独立介质，不能与数据库放在同一块单盘上。
JINGAO_BACKUP_PATH=./agent/backups
JINGAO_EVALUATION_DIR=./agent/data/evaluations
JINGAO_BACKUP_INTERVAL_SECONDS=86400
JINGAO_BACKUP_START_DELAY_SECONDS=120
JINGAO_BACKUP_MAX_AGE_SECONDS=93600
# 第二物理介质在 NAS 主机上的挂载目录；留空时系统明确告警，绝不把同盘目录视为第二备份。
JINGAO_OFFSITE_BACKUP_PATH=
JINGAO_OFFSITE_BACKUP_MAX_AGE_SECONDS=604800
JINGAO_DISK_WARNING_PERCENT=80
JINGAO_DISK_CRITICAL_PERCENT=90
JINGAO_MEMORY_WARNING_PERCENT=80
JINGAO_MEMORY_CRITICAL_PERCENT=90
ORIGINGAME_API_KEY=
JINGAO_LLM_ENABLED=true
# L3 生成上下文默认不出网；只有创始人明确批准后才改为 true。
JINGAO_LLM_L3_ENABLED=false
# L1/L2 only. L3 remains local unless separately approved below; L4 is never sent.
JINGAO_EMBEDDING_ENABLED=true
JINGAO_EMBEDDING_L3_ENABLED=false
