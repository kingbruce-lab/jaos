/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.local-ui-check/
/tmp/
/pytest-*/
*.tsbuildinfo

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/dev-server*.log
/.local-*.log

# env files (can opt-in for committing if needed)
.env*
